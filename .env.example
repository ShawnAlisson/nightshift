MONGODB_URI=mongodb://127.0.0.1:27017/nightshift
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48
# Mubit key with the "Inference" permission, from the Mubit console
MUBIT_API_KEY=
# Which provider the assistant uses: anthropic (default), openai, gemini or openrouter
# MUBIT_PROVIDER=anthropic
# Optional model overrides per provider
# MUBIT_ANTHROPIC_MODEL=claude-haiku-4-5
# MUBIT_OPENAI_MODEL=gpt-6-luna
# MUBIT_GEMINI_MODEL=gemini-3.8-flash
# OpenRouter: set the model your key serves (the default is a Claude model, which a
# Gemini/Vertex key cannot use). Check the exact slug at openrouter.ai/models.
# MUBIT_OPENROUTER_MODEL=google/gemini-3.8-flash
# Only use this OpenRouter provider (for bring-your-own-key, so requests never fall back to
# OpenRouter credit). For a Vertex key, use google-vertex.
# MUBIT_OPENROUTER_PROVIDER=google-vertex

# Set to "true" to require an invite code to register
SIGNUP_INVITE_ONLY=false
# The code people enter on the signup page (required when invite-only is on; keep it secret)
SIGNUP_INVITE_CODE=

# --- Computer use: the assistant operates a desktop in a Vercel Sandbox ---
# Uses the same provider and model as chat, for every provider. Claude and Gemini use their
# native computer-use tools; OpenAI and OpenRouter use function calling, so the model must
# support tools and image input. Native tools may need your own provider key in Mubit.
COMPUTER_USE_ENABLED=false
# Created once with `npm run desktop:snapshot`
SANDBOX_SNAPSHOT_ID=
# Vercel access: run `vercel link && vercel env pull` (OIDC), or set all three below
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
