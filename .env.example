MONGODB_URI=mongodb://127.0.0.1:27017/nightshift
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48
# Mubit key with the "Inference" permission, from the Mubit console
MUBIT_API_KEY=
# Which provider the assistant uses: anthropic (default), openai, gemini or openrouter
# MUBIT_PROVIDER=anthropic
# Optional model overrides per provider
# MUBIT_ANTHROPIC_MODEL=claude-haiku-4-5
# MUBIT_OPENAI_MODEL=gpt-6-luna
# MUBIT_GEMINI_MODEL=gemini-3.8-flash
# MUBIT_OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Set to "true" to require an invite code to register
SIGNUP_INVITE_ONLY=false
# The code people enter on the signup page (required when invite-only is on; keep it secret)
SIGNUP_INVITE_CODE=
